{
  "name": "atm-iris-desktop",
  "version": "1.0.0",
  "description": "Consola local de proyección y tiempos para iglesias",
  "main": "./out/main/index.js",
  "author": "Atmosfera",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "postinstall": "install-electron",
    "build:win": "pnpm build && electron-builder --win",
    "release:win": "pnpm build && electron-builder --win --x64 --publish never",
    "release:mac": "pnpm build && electron-builder --mac --x64 --arm64 -c.mac.hardenedRuntime=true -c.mac.notarize=true --publish never",
    "pack:win": "pnpm build && electron-builder --win zip --x64",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "build:mac": "pnpm build && electron-builder --mac -c.mac.identity=- --publish never",
    "test:packaged": "node scripts/smoke-packaged.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/bebas-neue": "^5",
    "@fontsource/inter": "^5",
    "@fontsource/lora": "^5",
    "@fontsource/merriweather": "^5",
    "@fontsource/montserrat": "^5",
    "@fontsource/newsreader": "^5",
    "@fontsource/oswald": "^5",
    "@fontsource/playfair-display": "^5",
    "@fontsource/poppins": "^5",
    "@hookform/resolvers": "^5",
    "@tanstack/react-query": "^5",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.6.7",
    "react-hook-form": "^7",
    "react-router": "^7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "uuid": "^13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7",
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4",
    "@types/babel__core": "^7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "private": true
}
